{
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "agent-decides",
  "editor": "vim",
  "model": "Gemini 3.8 Flash (Medium)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(*)",
      "command(go)",
      "command(statusline)",
      "command(mkdir)",
      "command(cat)",
      "command(echo)",
      "command(which)",
      "command(agy)",
      "command(ansible)",
      "command(gitleaks)",
      "command(git)",
      "command(find)",
      "command(ls)",
      "command(mv)",
      "command(cd)",
      "read_url(*)",
      "mcp(serena/get_current_config)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf /*)",
      "command(rm -rf ~)",
      "command(rm -rf ~/*)",
      "command(rm -rf $HOME)",
      "command(rm -rf $HOME/*)",
      "command(rm -fr /)",
      "command(rm -fr ~)",
      "command(mkfs*)",
      "command(dd if=/dev/zero*)",
      "command(dd if=/dev/urandom*)",
      "command(shutdown*)",
      "command(poweroff*)",
      "command(git push --force*)",
      "command(git push -f*)",
      "command(git reset --hard*)"
    ],
    "ask": [
      "command(unlink*)",
      "command(chmod -R*)",
      "command(chown -R*)",
      "command(git push*)",
      "command(git clean*)",
      "command(killall*)",
      "command(pkill*)",
      "command(brew uninstall*)",
      "command(pip uninstall*)"
    ]
  },
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "statusline --cli=auto",
    "enabled": true
  },
  "toolPermission": "proceed-in-sandbox",
  "trustedWorkspaces": [
    "/Users/crong",
    "/Users/crong/git/homelab",
    "/Users/crong/git/ai-agent-skill",
    "/Users/crong/git/dotfiles",
    "/Users/crong/git/statusline",
    "/Users/crong/git/247365",
    "/Users/crong/.config/shell_gpt",
    "/Users/crong/git/Meridian-X",
    "/Users/crong/git/sylph",
    "/Users/crong/git/heritage",
    "/Users/crong/Downloads",
    "/Users/crong/git/Vesper-X",
    "/Users/crong/.claude",
    "/Users/crong/git",
    "/Users/crong/git/dotfiles/mo",
    "/Users/crong/git/SM8600PUA"
  ]
}
