{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Skill(*)",
      "Bash(rm .git/index.lock)"
    ],
    "deny": [
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(bcdedit *)",
      "Bash(shutdown *)",
      "Bash(wbadmin *)"
    ],
    "ask": [
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(taskkill *)",
      "Bash(reboot *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/claude-remember/scripts/session-start-hook.sh\""
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/superpowers/hooks/run-hook.cmd\" session-start",
            "shell": "bash",
            "async": false
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/crong/.claude/hooks/claude-remember/scripts/session-start-hook.sh\""
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/crong/.claude/hooks/superpowers/hooks/run-hook.cmd\" session-start",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/claude-remember/scripts/user-prompt-hook.sh\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/crong/.claude/hooks/claude-remember/scripts/user-prompt-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/claude-remember/scripts/post-tool-hook.sh\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/crong/.claude/hooks/claude-remember/scripts/post-tool-hook.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/claude-remember/scripts/session-end-hook.sh\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/claude-remember/scripts/session-end-hook.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/crong/.claude/hooks/claude-remember/scripts/session-end-hook.sh\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/crong/.claude/hooks/claude-remember/scripts/session-end-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "statusline --cli=claude"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true,
    "notion@claude-plugins-official": false,
    "oh-my-claudecode@omc": true,
    "playwright@claude-plugins-official": true,
    "remember@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
