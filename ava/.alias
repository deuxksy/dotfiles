# eza as ls replacement
if command -v eza &> /dev/null; then
    alias ls='eza --icons=always'
    alias ll='eza -alhG --header --icons=always --group-directories-first --octal-permissions --git'
    alias la='eza -alhG --header --icons=always --group-directories-first --octal-permissions --total-size'
    alias lt='eza -T --icons=always --level=2'
else
    alias ls='ls -G'
    alias ll='ls -alfh'
fi

alias grep='grep --color=auto'
alias vi='nvim'
alias vim='nvim'
