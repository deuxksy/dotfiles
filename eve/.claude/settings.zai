{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "glm-5.3",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5-turbo",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3",
    "ANTHROPIC_MODEL": "opus",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1000000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "ENABLE_TOOL_SEARCH": "false",
    "FORCE_AUTOUPDATE_PLUGINS": "true"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Skill(*)",
      "mcp__gmail__create_draft",
      "mcp__gmail__get_thread",
      "mcp__gmail__label_message",
      "mcp__gmail__label_thread",
      "mcp__gmail__list_drafts",
      "mcp__gmail__list_labels",
      "mcp__gmail__search_threads",
      "mcp__gmail__unlabel_message",
      "mcp__gmail__unlabel_thread"
    ],
    "deny": [
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(bcdedit *)",
      "Bash(shutdown *)",
      "Bash(wbadmin *)"
    ],
    "ask": [
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(kill -9 *)",
      "Bash(taskkill *)",
      "Bash(reboot *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "claude-code-wakatime@wakatime": true,
    "notion@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "dev@zzizily": true,
    "docs@zzizily": true,
    "git@zzizily": true,
    "infra@zzizily": true,
    "l10n@zzizily": true,
    "review@zzizily": true,
    "rules@zzizily": true,
    "security@zzizily": true,
    "sessions@zzizily": true,
    "trackers@zzizily": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "glm-plan-usage@zai-coding-plugins": true,
    "glm-plan-bug@zai-coding-plugins": true,
    "expo@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "zzizily": {
      "source": {
        "source": "github",
        "repo": "deuxksy/ai-agent-skill"
      }
    },
    "zai-coding-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/crong/.npm/_npx/2f024689b4d0d3b0/node_modules/@z_ai/coding-helper/zai-coding-plugins"
      }
    }
  }
}
