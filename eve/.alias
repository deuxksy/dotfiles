# eza as ls replacement
if command -v eza &> /dev/null; then
    alias ls='eza --icons=always'
    alias ll='eza -alhF --header --icons=always --group-directories-first --octal-permissions --git'
    alias la='eza -alhF --header --icons=always --group-directories-first --octal-permissions --total-size'
    alias lt='eza -T --icons=always --level=2'
else
    alias ls='ls -G'
    alias ll='ls -alfh'
fi

alias grep='grep --color=auto'
alias vi='nvim'
alias vim='nvim'
alias gw="glow"

# claude debug — 로그는 ~/.claude/logs/log-YYMMDDhhmmss.log 에 파일로 남김
clauded() {
  mkdir -p ~/.claude/logs
  claude --debug --debug-file ~/.claude/logs/log-$(date +%y%m%d%H%M%S).log "$@"
}

# claude provider profile loader (apm agent layer 설계)
# usage: claude-profile zai|kimi|aperture [claude args...]
claude-profile() {
  local p="$1"; shift
  local d="$HOME/.config/claude/profiles"
  if [[ ! -r "$d/$p.env.sops" ]]; then
    echo "claude-profile: unknown profile '$p' (expected: zai|kimi|aperture)" >&2; return 1
  fi
  [[ -r "$d/mcp.env.sops" ]] && eval "$(sops -d --input-type dotenv --output-type dotenv "$d/mcp.env.sops")"
  eval "$(sops -d --input-type dotenv --output-type dotenv "$d/$p.env.sops")"
  if [[ -r "$d/$p.overlay.json" ]]; then
    claude --settings "$d/$p.overlay.json" "$@"
  else
    claude "$@"
  fi
}
