{
  "env": {
    "ANTHROPIC_BASE_URL": "http://ai",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5-turbo",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.2",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Skill(*)",
      "AskUserQuestion(*)",
      "CronCreate(*)",
      "CronDelete(*)",
      "CronList(*)",
      "EnterPlanMode(*)",
      "EnterWorktree(*)",
      "ExitPlanMode(*)",
      "ExitWorktree(*)",
      "LSP(*)",
      "ListMcpResourcesTool(*)",
      "NotebookEdit(*)",
      "ReadMcpResourceTool(*)",
      "TaskCreate(*)",
      "TaskGet(*)",
      "TaskList(*)",
      "TaskOutput(*)",
      "TaskStop(*)",
      "TaskUpdate(*)",
      "mcp__4_5v_mcp__*",
      "mcp__cloudflare-ai-gateway__*",
      "mcp__cloudflare-audit-logs__*",
      "mcp__cloudflare-autorag__*",
      "mcp__cloudflare-casb__*",
      "mcp__cloudflare-containers__*",
      "mcp__cloudflare-dex__*",
      "mcp__cloudflare-dns-analytics__*",
      "mcp__cloudflare-docs__*",
      "mcp__cloudflare-graphql__*",
      "mcp__cloudflare-logpush__*",
      "mcp__cloudflare-observability__*",
      "mcp__cloudflare-radar__*",
      "mcp__cloudflare-workers-bindings__*",
      "mcp__cloudflare-workers-builds__*",
      "mcp__context7__*",
      "mcp__globalping__*",
      "mcp__playwright__*",
      "mcp__plugin_oh-my-claudecode_t__*",
      "mcp__serena__*",
      "mcp__web_reader__*",
      "mcp__zai-github__*",
      "mcp__zai-vision__*",
      "mcp__zai-webreader__*",
      "mcp__zai-websearch__*",
      "mcp__filesystem__directory_tree",
      "mcp__codex__*"
    ],
    "deny": [
      "Bash(format *)",
      "Bash(diskpart *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(bcdedit *)",
      "Bash(shutdown *)",
      "Bash(wbadmin *)",
      "Bash(rm -rf *)",
      "Bash(kill *)",
      "Bash(del *)",
      "Bash(taskkill *)",
      "Bash(rd *)",
      "Bash(rmdir *)",
      "Bash(reg *)",
      "Bash(regedit *)",
      "Bash(sfc *)",
      "Bash(chkdsk *)",
      "Bash(sc *)",
      "Bash(netsh *)",
      "Bash(net stop *)",
      "Bash(net start *)",
      "Bash(net user *)",
      "Bash(dism *)",
      "Bash(systemreset *)",
      "Bash(cipher *)",
      "Bash(sysprep *)",
      "Bash(gpupdate *)",
      "Bash(powercfg *)",
      "Bash(wmic *)",
      "Bash(powershell Remove-*)",
      "Bash(powershell Stop-*)",
      "Bash(powershell Restart-*)",
      "Bash(powershell Set-Service *)",
      "Bash(powershell Disable-*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(rmdir *)",
      "Bash(del *)",
      "Bash(rd *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(kill -9 *)",
      "Bash(taskkill *)",
      "Bash(reboot *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "model": "glm-5.2",
  "statusLine": {
    "type": "command",
    "command": "sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud-cache.sh ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "glm-plan-usage@zai-coding-plugins": true,
    "glm-plan-bug@zai-coding-plugins": true,
    "code-review@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "deuxksy@zzizily": true,
    "oh-my-claudecode@omc": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "serena@claude-plugins-official": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "zzizily": {
      "source": {
        "source": "github",
        "repo": "deuxksy/ai-agent-skill"
      },
      "autoUpdate": true
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      },
      "autoUpdate": true
    },
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      },
      "autoUpdate": true
    }
  },
  "language": "korea",
  "verbose": true,
  "showTurnDuration": true
}
