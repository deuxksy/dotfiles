#!/usr/bin/env bash
# hiworks-mail-sync — hiworks POP3 증분 수신 → 로컬 Maildir 적립
# 사양: docs/superpowers/specs/2026-11-07-hiworks-mail-design.md
# 자격증명: ~/.config/hiworks/.env (HIWORKS_USER / HIWORKS_MAIL_PASS, chmod 600)
set -euo pipefail

ENV_FILE="$HOME/.config/hiworks/.env"
CACHE_DIR="$HOME/.cache/hiworks"
MAILDIR="$HOME/.local/share/hiworks-mail"
RCFILE="$CACHE_DIR/getmailrc"

# .env 검사: 존재 + 퍼미션 600 아니면 진행 금지 (평문 유출 방지)
if [[ ! -f "$ENV_FILE" ]]; then
  echo "error: $ENV_FILE 없음 — 생성 후 chmod 600 (HIWORKS_USER/HIWORKS_MAIL_PASS)" >&2
  exit 1
fi
perm=$(stat -f %Lp "$ENV_FILE")
if [[ "$perm" != "600" ]]; then
  echo "error: $ENV_FILE 퍼미션 ${perm} — chmod 600 필수" >&2
  exit 1
fi

# 자격증명 로드
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a
if [[ -z "${HIWORKS_USER:-}" || -z "${HIWORKS_MAIL_PASS:-}" ]]; then
  echo "error: HIWORKS_USER/HIWORKS_MAIL_PASS 미설정" >&2
  exit 1
fi

mkdir -p "$CACHE_DIR" "$MAILDIR"/{cur,new,tmp}

# 첫 실행 감지: 아카이브 비어 있으면 전체 수신 예고
if [[ -z $(find "$MAILDIR" -type f -print -quit 2>/dev/null) ]]; then
  echo "== 첫 실행: 받은편지함 전체 수신 — 수 분 소요 가능 =="
fi

# getmailrc 렌더링 — 고정 경로여야 oldmail state가 증분을 유지한다
old_umask=$(umask)
umask 177
cat > "$RCFILE" <<EOF
[retriever]
type = SimplePOP3SSLRetriever
server = pop3s.hiworks.com
port = 995
username = ${HIWORKS_USER}
password = ${HIWORKS_MAIL_PASS}

[destination]
type = Maildir
path = ${MAILDIR}

[options]
delete = false
read_all = false
message_log = ${CACHE_DIR}/getmail.log
EOF
umask "$old_umask"

exec getmail --rcfile="$RCFILE" --getmaildir="$CACHE_DIR"
