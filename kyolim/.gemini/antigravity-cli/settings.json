      "command(sudo *)",
      "command(git reset *)",
      "command(git clean *)",
      "command(git push * --force*)",
      "command(git push * -f*)",
      "command(git restore .)",
      "command(docker rm *)",
      "command(docker rmi *)",
      "command(docker system prune *)",
      "command(docker volume prune *)",
      "command(docker compose down -v*)",
      "command(kubectl delete *)",
